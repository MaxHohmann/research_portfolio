// ------------------------------------------------------------------------------------------------
//  EYE-TRACKER CALIBRATION
// ------------------------------------------------------------------------------------------------

protocol 'Calibration-12P' {

    report ('=====> STARTING CALIBRATION <=====')
    report ('Fixation Width: $CTRL_Fix_width_dva')

    start_device_io (Eyelink)
    clear_calibration (EyeCalibrator)

    // reset counter
    CALIB_count                             = 0


    trial {

        task 'Calibration Trial' {

            // ------------------------------------------------------------------------------------
            state CALIBRATION_HUB {

                report ('-----> TRIAL ($(CALIB_count + 1) / $CALIB_total) <-----')

                // exit 
                goto (
                    target                  = CALIBRATION_EXIT
                    when                    = CALIB_count == CALIB_total
                )

                // next trial
                goto (
                    target                  = CALIBRATION_START
                    when                    = CALIB_count < CALIB_total
                )
            }

            // ------------------------------------------------------------------------------------
            state CALIBRATION_START {

                CALIB_value                 = EYE_pos
                FixPoint_pos_x              = (((CALIB_value -1) % 4) - 1.5) * 5
                FixPoint_pos_y              = (floor((CALIB_value - 1) / 4) - 1) * 5

                
                report ('Calibration Trial: Fixation Point ($FixPoint_pos_x / $FixPoint_pos_y)')
                report ('Calibration Trial: Fixation Width = $CTRL_Fix_width_dva')

                direct (CALIBRATION_PRE_ACQUIRE)
            }

            // ------------------------------------------------------------------------------------     
            state CALIBRATION_PRE_ACQUIRE {

                live_queue_stimulus (fixationPoint)

                update_stimulus_display ()

                goto (
                    target                  = CALIBRATION_ACQUIRE
                    when                    = IO_fixation_flag
                )
            }

            // ------------------------------------------------------------------------------------      
            state CALIBRATION_ACQUIRE {

                report ('Calibration Trial: Pre Fixation Time ...')
                report ('Calibration Trial: Fixation == $IO_fixation_flag')

                start_timer (
                    timer                   = AcquireTimer
                    duration                = 250
                    duration_units          = ms
                )

                goto (
                    target                  = CALIBRATION_PRE_ACQUIRE
                    when                    = NOT(IO_fixation_flag)
                )

                timer_expired (
                    target                  = CALIBRATION_SAMPLE
                    timer                   = AcquireTimer
                )
            }

            // ------------------------------------------------------------------------------------          
            state CALIBRATION_SAMPLE {

                play_sound (Acquire_sound)

                start_timer (
                    timer                   = FixationTimer
                    duration                = CALIB_FixHold_ms
                    duration_units          = ms
                )

                begin_calibration_average (EyeCalibrator)

                goto (
                    target                  = CALIBRATION_REJECTED
                    when                    = NOT(IO_fixation_flag)
                )

                timer_expired (
                    target                  = CALIBRATION_ACCEPTED
                    timer                   = FixationTimer
                )
            }

            // ------------------------------------------------------------------------------------          
            state CALIBRATION_ACCEPTED {

                end_calibration_average_and_take_sample (
                    calibrator              = EyeCalibrator
                    calibratable_object     = fixationPoint
                )
                
                play_sound (Fixation_sound)

                dequeue_stimulus (fixationPoint)

                update_stimulus_display ()

                start_timer (
                    timer                   = ITI_Timer
                    duration                = CALIB_ITI_ms
                    duration_units          = ms
                )

                // update counter
                CALIB_count                 += 1

                accept_selections (EYE_pos)

                report ('Calibration Trial: Fixation Accepted!')

                goto (
                    target                  = CALIBRATION_HUB
                    when                    = timer_expired(ITI_Timer)
                )
            }

            // ------------------------------------------------------------------------------------         
            state CALIBRATION_REJECTED {

                end_calibration_average_and_ignore (
                    calibrator              = EyeCalibrator
                )

                play_sound (FixBreak_sound)

                dequeue_stimulus (fixationPoint)

                update_stimulus_display ()

                start_timer (
                    timer                   = ITI_Timer
                    duration                = CALIB_ITI_ms
                    duration_units          = ms
                )

                report ('Calibration Trial: Fixation Rejected!')

                reject_selections (EYE_pos)

                goto (
                    target                  = CALIBRATION_HUB
                    when                    = timer_expired(ITI_Timer)
                )
            }

            // ------------------------------------------------------------------------------------    
            state CALIBRATION_EXIT {

                update_stimulus_display ()

                update_calibration (EyeCalibrator)

                reset_selection (EYE_pos)

                report ('CALIBRATION COMPLETED!')
                report ('EXITING ...')

                wait (
                    duration                = CALIB_ITI_ms
                    duration_units          = ms
                )

                stop_device_io (Eyelink)

                yield ()
            }
        }            
    }
}



// ------------------------------------------------------------------------------------------------
//  Experiment Task 
// ------------------------------------------------------------------------------------------------

protocol 'Detection_Task' {

    report ('=====> STARTING EXPERIMENT <=====')

    // start devices
    start_device_io (gamePad)

    if_else {
        // start eye tracking if enabled
        if (EXP_use_eye_tracking == 1) {
            report ('Eye-Tracking: enabled')
            start_device_io (Eyelink)
        }
        // manually set fixation state 
        else {       
            report ('Eye-Tracking: disabled')                                
            IO_fixation_flag                = true  
        }
    }

    EXP_correct_input                       = true

    // assign fixation point position
    FixPoint_pos_x                          = 0
    FixPoint_pos_y                          = 0

    // reset TRIAL vars
    TRIAL_start                             = 0
    TRIAL_end                               = 0
    TRIAL_number                            = 0
    TRIAL_last_break                        = 0

    // reset counter vars
    INFO_trials_accepted                    = 0
    INFO_hit                                = 0
    INFO_miss                               = 0
    INFO_falseAlarm                         = 0
    INFO_correctRejection                   = 0
    INFO_earlyResponse                      = 0
    INFO_fixationBreak                      = 0

    // rest selection vars
    reset_selection (tIDs)
    

    trial {

        task 'Trial' {

            // ------------------------------------------------------------------------------------ 
            state EXPERIMENT_START {
                
                live_queue_stimulus (Background)

                live_queue_stimulus (FIELD_left)
                live_queue_stimulus (FIELD_right)
                live_queue_stimulus (FIELD_strip)

                live_queue_stimulus (fixationPoint)

                update_stimulus_display ()

                // check refresh rate
                if (CTRL_refresh_rate != round(refresh_rate())) {       
                    report ('WARNING: Invalid Refresh Rate $(round(refresh_rate()))')
                    EXP_correct_input       = false
                }

                // check session
                if_else {
                    // training
                    if (EXP_session == "train") {
                        TRIAL_total         = CTRL_trial_total_train
                    }
                    // main
                    if (EXP_session == "main") {
                        TRIAL_total         = CTRL_trial_total
                    }
                    // invalid input
                    else {
                        report ('WARNING: Invalid Attention Condition ($EXP_session)')
                        EXP_correct_input   = false
                    }
                }

                // report condition
                report ('Refresh Rate: $(round(refresh_rate())) Hz')
                report ('Session: $EXP_session ($TRIAL_total trials)')

                // exit experiment in case of invalid input
                goto (                    
                    target                  = EXPERIMENT_EXIT
                    when                    = (EXP_correct_input == false)
                )

                // start experiment task
                direct (INITIATE_RDP)
            }

            // ------------------------------------------------------------------------------------
            state INITIATE_RDP {

                // randomize initial directions
                DES_init_dir             = disc_rand(1,4)

                if_else {
                    if (DES_init_dir == 1) {
                        // initial direction
                        DES_gray_dir_init   = 315
                        DES_blue_dir_init   = 45

                        // assign direction change
                        DES_gray_dir_chng   = DES_gray_dir_init - CTRL_dir_chng_deg
                        DES_blue_dir_chng   = DES_blue_dir_init + CTRL_dir_chng_deg

                        // blue on top
                        live_queue_stimulus (RDP_L_gray)
                        live_queue_stimulus (RDP_R_gray)

                        live_queue_stimulus (RDP_L_blue)
                        live_queue_stimulus (RDP_R_blue)
                    }
                    if (DES_init_dir == 2) {
                        // initial direction
                        DES_gray_dir_init   = 315
                        DES_blue_dir_init   = 45

                        // assign direction change
                        DES_gray_dir_chng   = DES_gray_dir_init - CTRL_dir_chng_deg
                        DES_blue_dir_chng   = DES_blue_dir_init + CTRL_dir_chng_deg

                        // gray on top
                        live_queue_stimulus (RDP_L_blue)
                        live_queue_stimulus (RDP_R_blue)

                        live_queue_stimulus (RDP_L_gray)
                        live_queue_stimulus (RDP_R_gray) 
                    }
                    if (DES_init_dir == 3) {
                        // initial direction
                        DES_gray_dir_init   = 45
                        DES_blue_dir_init   = 315

                        // assign direction change
                        DES_gray_dir_chng   = DES_gray_dir_init + CTRL_dir_chng_deg
                        DES_blue_dir_chng   = DES_blue_dir_init - CTRL_dir_chng_deg

                        // blue on top
                        live_queue_stimulus (RDP_L_gray)
                        live_queue_stimulus (RDP_R_gray)

                        live_queue_stimulus (RDP_L_blue)
                        live_queue_stimulus (RDP_R_blue)
                    }
                    if (DES_init_dir == 4) {
                        // initial direction
                        DES_gray_dir_init   = 45
                        DES_blue_dir_init   = 315

                        // assign direction change
                        DES_gray_dir_chng   = DES_gray_dir_init + CTRL_dir_chng_deg
                        DES_blue_dir_chng   = DES_blue_dir_init - CTRL_dir_chng_deg

                        // gray on top
                        live_queue_stimulus (RDP_L_blue)
                        live_queue_stimulus (RDP_R_blue)

                        live_queue_stimulus (RDP_L_gray)
                        live_queue_stimulus (RDP_R_gray)
                    }
                }

                // assign initial directions
                RDP_L_gray_dir              = DES_gray_dir_init
                RDP_R_gray_dir              = DES_gray_dir_init

                RDP_L_blue_dir              = DES_blue_dir_init
                RDP_R_blue_dir              = DES_blue_dir_init


                live_queue_stimulus (fixationPoint)

                update_stimulus_display ()

                direct (TRIAL_HUB)    
            }            

            // ------------------------------------------------------------------------------------
            state TRIAL_HUB {

                CTRL_progress               = '$INFO_trials_accepted / $TRIAL_total Trials'

                if_else {
                    // first trial
                    if (TRIAL_number == 0) {
                        live_queue_stimulus (start_txt)
                    }
                    // all trials completed
                    if (INFO_trials_accepted == TRIAL_total) {
                        live_queue_stimulus (exit_txt)
                    }
                    // trial break
                    if (TRIAL_number % 100 == 0 && TRIAL_number != TRIAL_last_break) {
                        TRIAL_last_break    = TRIAL_number      // update trial number of last break
                        live_queue_stimulus (progress_txt)
                        live_queue_stimulus (break_txt)
                    }
                }

                update_stimulus_display ()

                dequeue_stimulus (progress_txt)
                dequeue_stimulus (start_txt)
                dequeue_stimulus (break_txt)
                dequeue_stimulus (exit_txt)

                wait (
                    duration                = CTRL_ISI_ms*1000 - CTRL_frame_buffer_us + (next_frame_time() - now())
                    duration_units          = us
                )


                // exit experiment
                goto (                    
                    target                  = EXPERIMENT_EXIT
                    when                    = (INFO_trials_accepted == TRIAL_total) 
                )

                // next trial
                goto (
                    target                  = TRIAL_START
                    when                    = (INFO_trials_accepted < TRIAL_total && IO_gpButton4 == 1 && IO_fixation_flag) 
                )
            }

            // ------------------------------------------------------------------------------------
            state TRIAL_START {

                update_stimulus_display ()

                ML_sync = 1

                TRIAL_start                 += 1
                TRIAL_number                += 1

                TRIAL_outcome               = ""
                TRIAL_RT_ms                 = -1
                TRIAL_SOA_true_ms           = -1
                TRIAL_target_onset          = 0
                TRIAL_target_shown          = 0

                report ('-----> TRIAL ($INFO_trials_accepted / $TRIAL_total) <-----')

                start_timer (
                    timer                   = Initial_Timer
                    duration                = CTRL_initial_ms*1000 - CTRL_frame_buffer_us + (next_frame_time() - now())
                    duration_units          = us
                )

                direct (ASSIGN_TRIAL_CONDITION)
            }

            // ------------------------------------------------------------------------------------
            state ASSIGN_TRIAL_CONDITION {

                // reset change flags
                DES_chg_col_gray            = 0
                DES_chg_col_blue            = 0
                DES_chg_dir_gray            = 0
                DES_chg_dir_blue            = 0

                // design cell
                TRIAL_tID                   = tIDs

                TRIAL_SOA_bin               = (TRIAL_tID - 1) % CTRL_SOA_bins
                TRIAL_SOA_ms                = CTRL_SOA_min_ms + TRIAL_SOA_bin * CTRL_SOA_step_ms
                DES_valid                   = floor((TRIAL_tID - 1) / CTRL_SOA_bins) % 2
                DES_bound                   = floor((TRIAL_tID - 1) / (2 * CTRL_SOA_bins)) % 2
                DES_carrier                 = floor((TRIAL_tID - 1) / (4 * CTRL_SOA_bins)) % 2

                TRIAL_catch                 = (rand() < CTRL_catch_prob)    // catch trial
                DES_cue_right               = disc_rand(0, 1)               // cue and target side

                if_else {
                    // cue right + target right
                    if (DES_valid == 1 && DES_cue_right == 1) {
                        DES_target_right    = DES_cue_right

                        TRIAL_cue_side      = "right"
                        TRIAL_target_side   = "right"
                        TRIAL_validity      = "valid"
                    }

                    // cue left + target left
                    if (DES_valid == 1 && DES_cue_right == 0) {
                        DES_target_right    = DES_cue_right

                        TRIAL_cue_side      = "left"
                        TRIAL_target_side   = "left"
                        TRIAL_validity      = "valid"
                    }

                    // cue right + target left
                    if (DES_valid == 0 && DES_cue_right == 1) {
                        DES_target_right    = 1 - DES_cue_right

                        TRIAL_cue_side      = "right"
                        TRIAL_target_side   = "left"
                        TRIAL_validity      = "invalid"
                    }

                    // cue left + target right
                    if (DES_valid == 0 && DES_cue_right == 0) {
                        DES_target_right    = 1 - DES_cue_right

                        TRIAL_cue_side      = "left"
                        TRIAL_target_side   = "right"
                        TRIAL_validity      = "invalid"
                    }
                }


                // randomize RDP change
                if_else {
                    // no catch trial
                    if (TRIAL_catch == 0) {

                        // color change not on carrier + bound
                        if (DES_carrier == 0 && DES_bound == 1) {
                            DES_chng_col_gray   = 1
                            DES_chng_dir_gray   = 1

                            TRIAL_type          = "bound"
                            TRIAL_carrier       = "grey"
                        }

                        // color change on carrier + bound
                        if (DES_carrier == 1 && DES_bound == 1) {
                            DES_chng_col_blue   = 1
                            DES_chng_dir_blue   = 1

                            TRIAL_type          = "bound"
                            TRIAL_carrier       = "blue"
                        }

                        // color change not on carrier + unbound
                        if (DES_carrier == 0 && DES_bound == 0) {
                            DES_chng_col_gray   = 1
                            DES_chng_dir_blue   = 1

                            TRIAL_type          = "unbound"
                            TRIAL_carrier       = "grey"
                        }

                        // color change on carrier + unbound
                        if (DES_carrier == 1 && DES_bound == 0) {
                            DES_chng_col_blue   = 1
                            DES_chng_dir_gray   = 1

                            TRIAL_type          = "unbound"
                            TRIAL_carrier       = "blue"
                        }
                    }
                    // catch trial
                    else {
                        DES_chng_col_gray       = 0
                        DES_chng_col_blue       = 0
                        DES_chng_dir_gray       = 0
                        DES_chng_dir_blue       = 0

                        TRIAL_type              = "catch"
                        TRIAL_carrier           = "none"
                    }
                }

                TRIAL_outcome               = ""
                TRIAL_RT_ms                 = -1
                TRIAL_SOA_true_ms           = -1
                TRIAL_target_onset          = 0
                TRIAL_target_shown          = 0


                report ('tID: $TRIAL_tID | type: $TRIAL_type | validity: $TRIAL_validity | cue: $TRIAL_cue_side | target: $TRIAL_target_side')
                report ('carrier: $TRIAL_carrier | SOA: $TRIAL_SOA_ms ms | initial dirs: grey $DES_gray_dir_init, blue $DES_blue_dir_init')


                // fixation lost
                goto (
                    target                  = FIXATION_BREAK
                    when                    = (IO_fixation_flag == 0)
                )

                // button released
                goto (
                    target                  = EARLY_RESPONSE
                    when                    = (IO_gpButton4 == 0)
                )

                // show cue
                goto (
                    target                  = CUE_ONSET
                    when                    = (timer_expired(Initial_Timer) && IO_gpButton4 == 1)
                )
            }

            // ------------------------------------------------------------------------------------
            state CUE_ONSET {

                if_else {
                    if (DES_cue_right == 1) {
                        live_queue_stimulus (CUE_right)
                    }
                    if (DES_cue_right == 0) {
                        live_queue_stimulus (CUE_left)
                    }
                }

                TRIAL_cue_us                = next_frame_time()

                update_stimulus_display ()

                // SOA timer
                start_timer (
                    timer                   = SOA_Timer
                    duration                = TRIAL_SOA_ms*1000 - CTRL_frame_buffer_us + (next_frame_time() - now())
                    duration_units          = us
                )

                // fixation lost
                goto (
                    target                  = FIXATION_BREAK
                    when                    = (IO_fixation_flag == 0)
                )

                // button released
                goto (
                    target                  = EARLY_RESPONSE
                    when                    = (IO_gpButton4 == 0)
                )

                // target onset
                goto (
                    target                  = TARGET_ONSET
                    when                    = timer_expired(SOA_Timer)
                )
            }

            // ------------------------------------------------------------------------------------
            state TARGET_ONSET {

                // realize target changes
                if_else {
                    // no catch trial + target left
                    if (TRIAL_catch == 0 && DES_target_right == 0) {
                        if_else {
                            // gray color
                            if (DES_chng_col_gray == 1) {
                                RDP_L_gray_color    = COL_gray_chng
                            }
                            // blue color
                            if (DES_chng_col_blue == 1) {
                                RDP_L_blue_color    = COL_blue_chng
                            }
                            // gray direction
                            if (DES_chng_dir_gray == 1) {
                                RDP_L_gray_dir      = DES_gray_dir_chng
                            }
                            // blue direction
                            if (DES_chng_dir_blue == 1) {
                                RDP_L_blue_dir      = DES_blue_dir_chng
                            }
                        }

                        TRIAL_target_shown      = 1
                    }
                    // no catch trial + target right
                    if (TRIAL_catch == 0 && DES_target_right == 1) {
                        if_else {
                            // gray color
                            if (DES_chng_col_gray == 1) {
                                RDP_R_gray_color    = COL_gray_chng
                            }
                            // blue color
                            if (DES_chng_col_blue == 1) {
                                RDP_R_blue_color    = COL_blue_chng
                            }
                            // gray direction
                            if (DES_chng_dir_gray == 1) {
                                RDP_R_gray_dir      = DES_gray_dir_chng
                            }
                            // blue direction
                            if (DES_chng_dir_blue == 1) {
                                RDP_R_blue_dir      = DES_blue_dir_chng
                            }
                        }

                        TRIAL_target_shown      = 1
                    }
                    // catch trial
                    if (TRIAL_catch == 1) {
                        TRIAL_target_shown      = 0
                    }
                }

                
                // compute cue onset duration
                TRIAL_target_us             = next_frame_time()
                TRIAL_SOA_true_ms           = (TRIAL_target_us - TRIAL_cue_us) / 1000

                update_stimulus_display ()

                TRIAL_target_onset          = 1

                // timer for change duration
                start_timer (
                    timer                   = Target_Timer
                    duration                = CTRL_target_ms*1000 - CTRL_frame_buffer_us + (next_frame_time() - now())
                    duration_units          = us
                )

                // time for responses
                start_timer (
                    timer                   = Response_Timer
                    duration                = CTRL_response_window_ms*1000 - CTRL_frame_buffer_us + (next_frame_time() - now())
                    duration_units          = us
                )

                direct (RESPONSE_HUB)
            }

            // ------------------------------------------------------------------------------------
            state RESPONSE_HUB {

                // fixation lost
                goto (
                    target                  = FIXATION_BREAK
                    when                    = (IO_fixation_flag == 0)
                )

                // button released after target
                goto (
                    target                  = HIT
                    when                    = (IO_gpButton4 == 0 && TRIAL_catch == 0)
                )

                // button released on catch trial
                goto (
                    target                  = FALSE_ALARM
                    when                    = (IO_gpButton4 == 0 && TRIAL_catch == 1)
                )

                // no response
                goto (
                    target                  = MISS
                    when                    = (timer_expired(Response_Timer) == 1 && TRIAL_catch == 0)
                )

                // correct rejection of catch trial
                goto (
                    target                  = CORRECT_REJECTION
                    when                    = (timer_expired(Response_Timer) == 1 && TRIAL_catch == 1)
                )

                // change back to initial colour and direction
                goto (
                    target                  = TARGET_OFFSET
                    when                    = (timer_expired(Target_Timer) == 1 && TRIAL_target_shown == 1)
                )
            }

            // ------------------------------------------------------------------------------------
            state TARGET_OFFSET {

                // reset changes
                RDP_L_gray_dir              = DES_gray_dir_init
                RDP_R_gray_dir              = DES_gray_dir_init
                RDP_L_blue_dir              = DES_blue_dir_init
                RDP_R_blue_dir              = DES_blue_dir_init

                RDP_L_gray_color            = COL_gray
                RDP_R_gray_color            = COL_gray
                RDP_L_blue_color            = COL_blue
                RDP_R_blue_color            = COL_blue

                update_stimulus_display ()

                TRIAL_target_shown          = 0

                direct (RESPONSE_HUB)
            }

            // ------------------------------------------------------------------------------------
            state HIT {

                TRIAL_RT_ms                 = (now() - TRIAL_target_us) / 1000
                TRIAL_outcome               = "hit"
                INFO_hit                    += 1

                play_sound (Hit_sound)

                TRIAL_ITI_ms                = CTRL_ITI_correct_ms

                accept_selections (tIDs)
                INFO_trials_accepted        += 1

                direct (TRIAL_EXIT)
            }

            // ------------------------------------------------------------------------------------
            state MISS {

                TRIAL_RT_ms                 = ''
                TRIAL_outcome               = "miss"
                INFO_miss                   += 1

                play_sound (Miss_sound)

                TRIAL_ITI_ms                = CTRL_ITI_wrong_ms

                accept_selections (tIDs)
                INFO_trials_accepted        += 1

                direct (TRIAL_EXIT)
            }

            // ------------------------------------------------------------------------------------
            state FALSE_ALARM {

                TRIAL_RT_ms                 = (now() - TRIAL_target_us) / 1000
                TRIAL_outcome               = "falseAlarm"
                INFO_falseAlarm             += 1

                play_sound (FixBreak_sound)

                TRIAL_ITI_ms                = CTRL_ITI_wrong_ms

                // catch trials never consume a design cell
                reject_selections (tIDs)

                direct (TRIAL_EXIT)
            }

            // ------------------------------------------------------------------------------------
            state CORRECT_REJECTION {

                TRIAL_RT_ms                 = ''
                TRIAL_outcome               = "correctRejection"
                INFO_correctRejection       += 1

                play_sound (Hit_sound)

                TRIAL_ITI_ms                = CTRL_ITI_correct_ms

                // catch trials never consume a design cell
                reject_selections (tIDs)

                direct (TRIAL_EXIT)
            }

            // ------------------------------------------------------------------------------------
            state EARLY_RESPONSE {
                
                TRIAL_RT_ms                 = ''
                TRIAL_outcome               = "earlyResponse"
                INFO_earlyResponse          += 1

                play_sound (FixBreak_sound)

                TRIAL_ITI_ms                = CTRL_ITI_abort_ms

                // early response trials never consume a design cell
                reject_selections (tIDs)

                direct (TRIAL_EXIT)
            }

            // ------------------------------------------------------------------------------------
            state FIXATION_BREAK {

                TRIAL_RT_ms                 = ''
                TRIAL_outcome               = "fixationBreak"
                INFO_fixationBreak          += 1

                play_sound (FixBreak_sound)

                TRIAL_ITI_ms                = CTRL_ITI_abort_ms
                
                // fixation break trials never consume a design cell
                reject_selections (tIDs)

                direct (TRIAL_EXIT)
            }

            // ------------------------------------------------------------------------------------
            state TRIAL_EXIT {
                
                report ('Trial Outcome: $TRIAL_outcome')
                report ('RT: $TRIAL_RT_ms')

                // reset stimuli to the initial state
                dequeue_stimulus (CUE_left)
                dequeue_stimulus (CUE_right)

                RDP_L_gray_dir              = DES_gray_dir_init
                RDP_R_gray_dir              = DES_gray_dir_init
                RDP_L_blue_dir              = DES_blue_dir_init
                RDP_R_blue_dir              = DES_blue_dir_init

                RDP_L_gray_color            = COL_gray
                RDP_R_gray_color            = COL_gray
                RDP_L_blue_color            = COL_blue
                RDP_R_blue_color            = COL_blue

                TRIAL_target_shown          = 0

                update_stimulus_display ()

                TRIAL_end                   = TRIAL_start
                ML_sync                     = 0

                wait (
                    duration                = TRIAL_ITI_ms
                    duration_units          = ms
                )

                // report trial summary
                report ('Outcome: $TRIAL_outcome | RT: $TRIAL_RT_ms ms | measured SOA: $TRIAL_SOA_true_ms ms')
                report ('Hit: $INFO_hit | Miss: $INFO_miss | FA: $INFO_falseAlarm | CR: $INFO_correctRejection | Early: $INFO_earlyResponse | FixBreak: $INFO_fixationBreak')

                direct (INITIATE_RDP)
            }

            // ------------------------------------------------------------------------------------
            state EXPERIMENT_EXIT {

                report ('EXPERIMENT COMPLETED!')
                report ('EXITING ...')

                wait (
                    duration                = 1000*1000 - CTRL_frame_buffer_us + (next_frame_time() - now())
                    duration_units          = us
                )

                dequeue_stimulus (fixationPoint)

                update_stimulus_display ()

                // stop devices
                stop_device_io (gamePad)

                if (EXP_use_eye_tracking == 1) {
                    stop_device_io (Eyelink)
                }

                yield ()
            }
        }
    }
}
