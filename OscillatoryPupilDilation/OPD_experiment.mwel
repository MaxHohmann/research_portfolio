// ------------------------------------------------------------------------------------------------
//  OSCILLATORY PUPIL DILATION PROJECT - EXPERIMENT
// ------------------------------------------------------------------------------------------------
/*
Version :   1.0.0
Date    :   27/10/2026
Author  :   Maximilian Hohmann
            mhohmann@dpz.eu
            maximilian.hohmann@stud.uni-goettingen.de
        

DESCRIPTION:

Display     : Left half of the screen is white, right half is black, separated by a narrow grey strip
              in the centre. A central fixation point sits on the strip.
Stimuli     : On each side two superimposed random dot patterns (RDP) are shown: a grey and a blue
              one, both 100 % coherent, whose directions differ by 90 deg. Both sides initially
              show the same directions.
Cue         : An arrow next to the fixation point points to the left or to the right (random).
Target      : A simultaneous colour change AND motion direction change on ONE side (valid = cued side,
              invalid = opposite side). Two target configurations:
              - BOUND   : the same RDP (grey or blue) changes colour and direction.
              - UNBOUND : one RDP changes colour, the OTHER RDP on the same side changes direction.
              The carrier RDP (grey / blue) is counterbalanced. Directions always rotate AWAY from the
              other RDP, so the two RDPs never merge into the same direction.
Task        : Participants hold the response button (trigger) during the trial and RELEASE it as fast as
              possible when the target occurs. Holding through the response window on catch trials is
              correct; releasing before the target or during a catch trial is an error.
SOA         : Cue onset -> target onset = CTRL_SOA_min_ms + bin * CTRL_SOA_step_ms. Every bin occurs
              equally often in every design cell (tIDs, random without replacement), i.e. uniform
              sampling over all time intervals.
Catch trials: With probability CTRL_catch_prob a trial contains no target (the nominal SOA still
              defines the start of the response window). Catch trials are rejected from the selection,
              so the design cells stay balanced.
Design cells: tIDs = 1 : (8 * CTRL_SOA_bins)
                SOA bin   = (tID-1) % bins
                valid     = floor((tID-1) / bins) % 2
                bound     = floor((tID-1) / (2*bins)) % 2        (0 = unbound, 1 = bound)
                carrier   = floor((tID-1) / (4*bins)) % 2        (0 = grey, 1 = blue)
Eye tracking: As in OPD_experiment.mwel (EyeLink, blink correction, drift correction before each trial).
              A fixation break or an early release aborts the trial; it is repeated later.
*/



// ------------------------------------------------------------------------------------------------
//  IO Devices
// ------------------------------------------------------------------------------------------------

// ---------- Display ----------
stimulus_display 'Stimulus Display' (BG_r, BG_g, BG_b)


// ---------- Eyelink ----------
eyelink Eyelink (

    data_interval                           = 1ms
    eye_rx                                  = EYE_right_x_raw
    eye_ry                                  = EYE_right_y_raw
    eye_lx                                  = EYE_left_x_raw
    eye_ly                                  = EYE_left_y_raw 
    eye_x                                   = EYE_x_raw
    eye_y                                   = EYE_y_raw 
    href_rx                                 = EYE_href_right_x
    href_ry                                 = EYE_href_right_y
    href_lx                                 = EYE_href_left_x
    href_ly                                 = EYE_href_left_y
    pupil_rx                                = EYE_pupil_right_x
    pupil_ry                                = EYE_pupil_right_y
    pupil_lx                                = EYE_pupil_left_x
    pupil_ly                                = EYE_pupil_left_y
    pupil_size_r                            = EYE_pupil_right_size
    pupil_size_l                            = EYE_pupil_left_size
    eye_time                                = EYE_sample_time
    tracking_dist                           = 1024
    tracker_ip                              = '100.1.1.1'
)


// ---------- Eye Calibrator ----------
standard_eye_calibrator EyeCalibrator (

    eyeh_raw                                = EYE_x_raw
    eyev_raw                                = EYE_y_raw
    eyeh_calibrated                         = EYE_x_dva 
    eyev_calibrated                         = EYE_y_dva
)


// ---------- Eye Monitor ----------
basic_eye_monitor EyeMonitor (

    eyeh_calibrated                         = EYE_x_dva
    eyev_calibrated                         = EYE_y_dva
    eye_state                               = EYE_saccade
    width_samples                           = 5
    saccade_entry_speed                     = 50
    saccade_exit_speed                      = 20
)


// ---------- Gamepad ----------
iodevice/usbhid_generic gamePad (

    preferred_location_id                   = 1
    usage_page                              = 1
    usage                                   = 4
    log_all_input_values                    = false
    autostart                               = true
) {
    // Buttons
    usbhid_generic_input_channel (usage_page = 9; usage = 4; value = IO_gpButton4)
    usbhid_generic_input_channel (usage_page = 9; usage = 2; value = IO_gpButton2)
}



// ------------------------------------------------------------------------------------------------
//  Variables
// ------------------------------------------------------------------------------------------------

// ---------- Input ----------
group Condition {

    var EXP_note                            = "OscillatoryPupilDilationProject"
    var EXP_version                         = "1.0.0"

    var EXP_session                         = "main"        // train, main

    var EXP_correct_input                   = true          // validate input
    var EXP_use_eye_tracking                = true          // enable eye tracking
    var EXP_debugging                       = false         // enable reports

    // Info
    var INFO_trials_accepted                = 0             // number of accapted trials
    var INFO_hit                            = 0             // number of hits
    var INFO_miss                           = 0             // number of misses
    var INFO_falseAlarm                     = 0             // number of false alarms
    var INFO_correctRejection               = 0             // number of correct rejection
    var INFO_earlyResponse                  = 0             // number of early responses
    var INFO_fixationBreak                  = 0             // number of fixation break trials
}


// ---------- Trial ----------
group TRIAL {

    var TRIAL_start                         = 0
    var TRIAL_end                           = 0
    var TRIAL_number                        = 0
    var TRIAL_total                         = 0
    var ML_sync                             = 0

    var TRIAL_tID                           = 0             // design cell of this trial
    var TRIAL_catch                         = 0             // 1 = catch trial (no target)
    var TRIAL_type                          = ""            // bound, unbound, catch
    var TRIAL_validity                      = ""            // valid, invalid, catch
    var TRIAL_cue_side                      = ""            // left, right
    var TRIAL_target_side                   = ""            // left, right, none
    var TRIAL_carrier                       = ""            // grey, blue (RDP carrying the colour change)
   
    var TRIAL_SOA_bin                       = 0
    var TRIAL_SOA_ms                        = 0             // nominal SOA
    var TRIAL_SOA_true_ms                   = 0             // measured SOA (frame times)
    
    var TRIAL_cue_us                        = 0
    var TRIAL_target_us                     = 0
    var TRIAL_target_onset                  = 0             // marker: target (or catch pseudo-target) onset
    var TRIAL_target_shown                  = 0
    
    var TRIAL_RT_ms                         = 0
    
    var TRIAL_outcome                       = ""            // hit, miss, falseAlarm, correctRejection, earlyResponse, fixationBreak

    var TRIAL_ITI_ms                        = 0             // inter trial interval (depending on trial outcome)
    var TRIAL_last_break                    = 0             // update trial number of last break
}


// ---------- Design ----------
group DES {

    var DES_valid                           = 0             // cue validity
    var DES_bound                           = 0             // change bound to one RDP
    var DES_carrier                         = 0             // 0 = grey, 1 = blue
    var DES_cue_right                       = 0             // cue location
    var DES_target_right                    = 0             // target location

    var DES_init_dir                        = 0             // condition of initial direction and RDP on top
    
    var DES_gray_dir_init                   = 0
    var DES_blue_dir_init                   = 0
    var DES_gray_dir_chng                   = 0
    var DES_blue_dir_chng                   = 0

    var DES_chng_col_gray                   = 0
    var DES_chng_col_blue                   = 0
    var DES_chng_dir_gray                   = 0
    var DES_chng_dir_blue                   = 0
}


// ---------- Gamepad ----------
group Gamepad {

    var IO_gpButton2                        = 0
    var IO_gpButton4                        = 0
}


// ---------- Eye Tracking ----------
group EYE { 

    // eyelink
    var EYE_right_x_raw                     = (float)(0)(persistant = YES)
    var EYE_right_y_raw                     = (float)(0)(persistant = YES)
    var EYE_left_x_raw                      = (float)(0)(persistant = YES)
    var EYE_left_y_raw                      = (float)(0)(persistant = YES)
    var EYE_x_raw                           = (float)(0)(persistant = YES)
    var EYE_y_raw                           = (float)(0)(persistant = YES)
    var EYE_href_right_x                    = (integer)(0)(persistant = YES)
    var EYE_href_right_y                    = (integer)(0)(persistant = YES)
    var EYE_href_left_x                     = (integer)(0)(persistant = YES)
    var EYE_href_left_y                     = (integer)(0)(persistant = YES)
    var EYE_pupil_right_x                   = (integer)(0)(persistant = YES)
    var EYE_pupil_right_y                   = (integer)(0)(persistant = YES)
    var EYE_pupil_left_x                    = (integer)(0)(persistant = YES)
    var EYE_pupil_left_y                    = (integer)(0)(persistant = YES)
    var EYE_pupil_right_size                = (integer)(0)(persistant = YES)
    var EYE_pupil_left_size                 = (integer)(0)(persistant = YES)
    var EYE_sample_time                     = (integer)(0)(persistant = YES)
    
    // calibrator
    var EYE_x_dva                           = (float)(0)(persistant = YES)
    var EYE_y_dva                           = (float)(0)(persistant = YES)     

    // monitor
    var EYE_saccade                         = (integer)(0)(persistant = YES)
    var IO_fixation_flag                    = false
}


// ---------- Calibration ----------
group Calibration {

    var CALIB_value                         = 0
    var CALIB_count                         = 0
    var CALIB_total                         = 12
    var CALIB_ITI_ms                        = 900
    var CALIB_FixHold_ms                    = 900
}


// ---------- Control ----------
group CTRL {

    // fixation
    var CTRL_Fix_width_dva                  = 50                        // default for calibration (diameter)        

    // design
    var CTRL_SOA_bins                       = 81                        // number of SOA bins
    var CTRL_SOA_min_ms                     = 1000                      // shortest cue-target SOA
    var CTRL_SOA_step_frames                = 3                         // bin width in frames (3 frames = 25 ms @ 120 Hz)
    var CTRL_selection_total                = 8 * CTRL_SOA_bins         // all design cells (valid x bound x carrier x soa bins)
    var CTRL_trial_total                    = CTRL_selection_total      // accepted trials main session
    var CTRL_trial_total_train              = 100                       // accepted trials training
    var CTRL_catch_prob                     = 0.25                      // probability of a catch trial

    // formula to compute precise timing
    var CTRL_refresh_rate                   = 120                                       // frame rate in Hz
    var CTRL_frame_ms                       = 2/CTRL_refresh_rate * 1000                // two frame buffer time
    var CTRL_frame_buffer_us                = CTRL_frame_ms * 1000 + CTRL_frame_ms * 100    // time buffer for precise timer
    var CTRL_SOA_step_ms                    = CTRL_SOA_step_frames / CTRL_refresh_rate * 1000

    
    // timer
    var CTRL_ISI_ms                         = 300                       // inter stimulus interval
    var CTRL_initial_ms                     = 500                       // stable display before cue onset
    var CTRL_target_ms                      = 125                       // target change duration
    var CTRL_response_window_ms             = 900                       // response window after target onset
    
    var CTRL_ITI_correct_ms                 = 600                       // ITI for hit and correct rejection
    var CTRL_ITI_wrong_ms                   = 600                       // ITI for miss and false alarm
    var CTRL_ITI_abort_ms                   = 600                       // ITI for early response and fixation break


    // target
    var CTRL_dir_chng_deg                   = 90                        // direction change of the target RDP

    // other
    var CTRL_progress                       = ''                        // text to display trial progress
}


// ---------- Color ----------
group Color {

    // background
    var BG_r                                = 0.5
    var BG_g                                = 0.5
    var BG_b                                = 0.5

    // text
    var TXT_r                               = 1.0
    var TXT_g                               = 1.0
    var TXT_b                               = 1.0

    // RDP colours
    var COL_gray                            = '0.23,0.23,0.23'      // initial grey color
    var COL_blue                            = '0.25,0.25,1'         // initial blue color

    var COL_gray_chng                       = '0.73,0.23,0.23'      // changed grey color
    var COL_blue_chng                       = '0.75,0.25,1'         // initial blue color
}


// ---------- Screen ----------
group SCREEN {

    var SCREEN_L_col                        = 1             // left half: white
    var SCREEN_L_width_dva                  = 80            // width
    var SCREEN_L_height_dva                 = 80            // height

    var SCREEN_R_col                        = 0             // right half: black
    var SCREEN_R_width_dva                  = 80            // width
    var SCREEN_R_height_dva                 = 80            // height

    var SCREEN_strip_col                    = 0.5           // right half: black
    var SCREEN_strip_width_dva              = 1             // width
    var SCREEN_strip_height_dva             = 80            // height
}


// ---------- Fixation Point ----------
group fixationPoint {

    var FixPoint_alpha                      = 1
    var FixPoint_r                          = 1
    var FixPoint_g                          = 1
    var FixPoint_b                          = 1
    var FixPoint_size                       = .2
    var FixPoint_pos_x                      = 0
    var FixPoint_pos_y                      = 0
}


// ---------- Random Dot Pattern ----------
group RDP {

    var RDP_space                           = "linear"      // linear motion
    var RDP_radius                          = 3

    var RDP_pos_x_L                         = -10           // x position of the left pair
    var RDP_pos_x_R                         = 10            // x position of the right pair
    var RDP_pos_y                           = 0 
    var RDP_pos_z                           = 0

    var RDP_dot_num                         = 60            // dots per RDP
    var RDP_dot_size                        = 0.3
    var RDP_dot_lifetime                    = -1
    var RDP_speed                           = 6

    var RDP_alpha                           = 1   

    var RDP_L_gray_color                    = COL_gray
    var RDP_L_blue_color                    = COL_blue
    var RDP_R_gray_color                    = COL_gray
    var RDP_R_blue_color                    = COL_blue

    var RDP_L_gray_dir                      = 0
    var RDP_L_blue_dir                      = 0
    var RDP_R_gray_dir                      = 0
    var RDP_R_blue_dir                      = 0
}


// ---------- Cue ----------
group CUE (

    var CUE_size                            = 2
    var CUE_pos_x                           = 0         // cue at the center
    var CUE_pos_y                           = 2         // cue over fixation point
    var CUE_alpha                           = 1
)


// ---------- Selection ----------
group Selection {

    // design cells: SOA bin x validity x bound/unbound x carrier
    selection tIDs (
        values                              = 1:CTRL_selection_total
        selection                           = random_without_replacement
        nsamples                            = 1
        sampling_method                     = cycles
        advance_on_accept                   = YES
        autoreset                           = YES
    )

    // calibration location
    selection EYE_pos (
        values                              = 1:CALIB_total
        selection                           = random_without_replacement
        nsamples                            = 1
        sampling_method                     = cycles
        advance_on_accept                   = YES
        autoreset                           = YES
    )
}



